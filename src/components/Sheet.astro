---
import { SITE, queries } from '../data/content';
import frames from '../data/frames.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const rows = [1, 2].map((row) =>
  frames.filter((f) => f.row === row).sort((a, b) => a.rank - b.rank)
);
const hits = frames.filter((f) => f.correct).length;
const total = frames.length;
---

<section class="wrap">
  <div class="sheet">
    <div class="sheet__bar">
      <div class="sheet__mark">
        <img src={`${base}logo.svg`} alt="" width="22" height="22" />
        <b>GLAW</b>
      </div>
      <p class="mono sheet__data" style="margin:0">
        RSTPReid test · top-10 per query · {hits}/{total} frames match
      </p>
    </div>

    <div class="sheet__body">
      <h1 class="claim">
        Global&#8209;Local Agreement&#8209;Weighted Dual&#8209;Feature Learning <em>for</em>
        Text&#8209;Based Person Search
      </h1>

      <p class="byline">
        {SITE.authors}<sup class="star">*</sup>
      </p>
      <p class="mono" style="margin:0.35rem 0 0;color:var(--sheet-muted)">
        * corresponding author
      </p>

      <div class="acts">
        <a class="btn btn--go" href={SITE.repo}>
          Code <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
        <a class="btn" href="#method">Method</a>
        <a class="btn" href="#results">Results</a>
      </div>

      <div class="strips">
        {
          rows.map((row, ri) => (
            <div class="strip">
              <div class="strip__query">
                <span class="strip__tag">{queries[ri].tag}</span>
                <p class="strip__text">{queries[ri].text}</p>
              </div>
              <ol class="strip__grid">
                {row.map((f, i) => (
                  <li
                    class:list={['frame', f.correct && 'frame--hit']}
                    style={`--i:${ri * 10 + i}`}
                  >
                    <div class="shot">
                      <img
                        src={`${base}frames/${f.file}`}
                        alt={`Rank ${f.rank}: ${f.correct ? 'the identity described' : 'a different identity'}`}
                        width={f.w}
                        height={f.h}
                        loading={ri === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                    <span class="cap">{String(f.rank).padStart(2, '0')}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }

        <div class="sheet__legend mono">
          <span class="key"><i class="hit"></i> same identity as described</span>
          <span class="key"><i class="miss"></i> a different identity</span>
          <span class="key">captions verbatim from RSTPReid</span>
        </div>
      </div>
    </div>
  </div>
</section>
